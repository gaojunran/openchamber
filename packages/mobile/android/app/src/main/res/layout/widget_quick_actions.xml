<?xml version="1.0" encoding="utf-8"?>
<!-- iOS parity: the small widget is a title, the attention count and the two entry points. The
     actions stack instead of sitting side by side because "New session" cannot share a 2-cell
     width with another label without wrapping mid-word. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:text="@string/widget_chat"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_attention"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:text=""
        android:textColor="#FFFF9F0A"
        android:textSize="11sp" />

    <!-- RemoteViews inflates from a fixed view whitelist: Space and a bare View are both refused,
         so the gap is an empty TextView. -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/quick_new"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_pill_accent"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:singleLine="true"
        android:text="@string/widget_new_session"
        android:textColor="#FF64B5FF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/quick_attention"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_pill"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:singleLine="true"
        android:text="@string/widget_attention"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp" />
</LinearLayout>
